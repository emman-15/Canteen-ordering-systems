# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================

# Database Connection URL:
# For Neon Serverless PostgreSQL (copy from https://console.neon.tech):
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# If left blank, the app will automatically fall back to local SQLite (canteen.db)
DATABASE_URL=

# Secret key for session encryption (generate a random string for production):
SECRET_KEY=canteen-change-this-in-production-random-secret-key-12345

# Port to bind (Render automatically supplies PORT):
PORT=5000
